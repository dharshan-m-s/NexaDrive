# NexaDrive uses an embedded SQLite database. PostgreSQL is NOT required.
DATABASE_PATH=./data/nexadrive.db
STORAGE_ROOT=./storage
BIND_ADDR=127.0.0.1:8080
# The public address clients type into the app. There is no magic-DNS
# default: every network has its own. On a Tailscale tailnet this is the
# machine's magic DNS name (https://<machine>.<tailnet>.ts.net); on a LAN
# it might be http://<lan-ip>:8080 or a reverse proxy hostname.
# Leave unset if clients should supply their own address.
# PUBLIC_URL=https://your-server.your-network.ts.net
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
RUST_LOG=info,nexadrive_server=debug
MAX_UPLOAD_BYTES=10737418240

# Optional Restic backup integration
# RESTIC_REPOSITORY=/backup/nexadrive-restic
# RESTIC_PASSWORD_FILE=/etc/nexadrive/restic-password
# RESTIC_BIN=restic

# Optional browser origins. Leave empty for the native clients.
CORS_ORIGINS=
