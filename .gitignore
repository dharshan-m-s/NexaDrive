# ---------------------------------------------------------------------------
# NexaDrive — root .gitignore
#
# Runtime data, secrets, build output and machine-specific files must never
# be committed. Everything required to build and run from a fresh clone is
# intentionally NOT ignored (source, lockfiles, migrations, service units,
# packaging scripts, sanitized env templates).
# ---------------------------------------------------------------------------

# --- Server runtime state (never commit) -----------------------------------
# SQLite database, WAL/SHM files, user files, backups, upload staging, logs.
data/
storage/
backups/
logs/
temp/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Server configuration secrets ------------------------------------------
server/.env
.env
.env.*
*.env
*.env.local
*.env.*.local
!.env.example

# --- Private keys, certificates and credential material ---------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
id_rsa
id_rsa.*
id_ed25519
id_ecdsa
id_dsa
*.ppk
.netrc
.aws/
.ssh/

# --- Rust build output -----------------------------------------------------
server/target/
target/

# --- Flutter / Dart ---------------------------------------------------------
app/.dart_tool/
app/build/
app/android/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
.android/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/captures/
app/android/**/*.jks
app/android/**/*.keystore
app/linux/flutter/ephemeral/
app/windows/flutter/ephemeral/
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt
coverage/
*.symbols
*.map.json

# --- Node / frontend build output -------------------------------------------
node_modules/
dashboard/dist/
*.tsbuildinfo
*.local

# --- Release artifacts produced by local/CI packaging ----------------------
dist/
release-artifacts/
*.AppImage
*.deb
*.apk
*.aab

# --- Editor / IDE -----------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# --- OS noise ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.dll
*.exe

# --- Agent / AI tooling (local only, never commit) --------------------------
# Skill packs, prompts, per-tool caches and machine-local agent state.
.agents/
.claude/
.opencode/
.cursor/
.aider*
.freebuff/
skills-lock.json
.claude.json

# --- Screenshots and large binary captures -----------------------------------
screenshots/

# --- Logs / test output ------------------------------------------------------
*.log
.coverage/
test_results/